FROM node:20-alpine

ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ARG NEXT_PUBLIC_GRAFANA_URL=http://localhost:3000
ARG NEXT_PUBLIC_GRAFANA_DASHBOARD_URL=http://localhost:3000/d/myfitnesspal-overview/myfitnesspal-overview?orgId=1&refresh=30s&kiosk

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
	NEXT_PUBLIC_GRAFANA_URL=$NEXT_PUBLIC_GRAFANA_URL \
	NEXT_PUBLIC_GRAFANA_DASHBOARD_URL=$NEXT_PUBLIC_GRAFANA_DASHBOARD_URL

WORKDIR /app

COPY package.json ./
RUN npm install

COPY . .
RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
